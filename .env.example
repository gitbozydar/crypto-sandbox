# Baza PostgreSQL
DATABASE_URL=postgresql://uzytkownik:haslo@host/baza?sslmode=require

# Better Auth — sekret wygeneruj: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Maile przez Gmail (opcjonalnie) — hasło aplikacji z myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASSWORD=

# Inna poczta niż Gmail (opcjonalnie)
# SMTP_HOST=smtp.wp.pl
# SMTP_PORT=465

# Wyższy limit zapytań CoinGecko (opcjonalnie)
# COINGECKO_API_KEY=
